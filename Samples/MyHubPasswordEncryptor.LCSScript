Include Library/.Net10.0.0/String.LCSScriptInclude
Include Library/.Net10.0.0/Cryptography.LCSScriptInclude

Include Library/ScriptHostConsole.LCSScriptInclude

PrintTitle("My Hub Password Encryptor")

PlainPassword = _
If(Parameter1:IsNotMissing())
{
	PlainPassword = Parameter1
	Host:WriteLine("Plain Password? " + PlainPassword)
}
Else()
{
	PlainPassword = GetFromUser("Plain Password? ")
}

EncryptionKey = _
If(Parameter2:IsNotMissing())
{
	EncryptionKey = Parameter2
	Host:WriteLine("Encryption Key? " + EncryptionKey)
}
Else()
{
	EncryptionKey = GetFromUser("Encryption Key? ")
}

Host:WriteLine()

AESEngine = CreateAESEngine()
AESEngine:Mode = GetCipherModeEnum():ECB
AESEngine:Padding = GetPaddingModeEnum():PKCS7
AESEngine:Key = GenerateMD5Hash(EncryptionKey)

Data = GetEncodingClass():UTF8:GetBytes(PlainPassword)

AESEncryptor = AESEngine:CreateEncryptor()
Data = AESEncryptor:TransformFinalBlock(Data, ZeroInt32, Data:Length)
AESEncryptor:Dispose()

AESEngine:Dispose()

Host:WriteLine("Encrypted Password: " + GetConvertClass():ToBase64String(Data))

WaitIfNeeded("Press a key...")